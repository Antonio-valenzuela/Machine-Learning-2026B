        "## Code 5 — Python Implementation of MAE\n",
        "\n",
        "Se define la función MAE y las validaciones incluidas por el autor."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 5,
      "id": "6dce3341",
      "metadata": {
        "id": "6dce3341"
      },
      "outputs": [],
      "source": [
        "import numpy as np\n",
        "\n",
        "def mae_loss(y_pred, y_true):\n",
        "    \"\"\"\n",
        "    Compute the Mean Absolute Error (MAE) between predicted and true values.\n",
        "\n",
        "    Parameters:\n",
        "    y_pred (numpy.ndarray): Predicted values.\n",
        "    y_true (numpy.ndarray): True values.\n",
        "\n",
        "    Returns:\n",
        "    float: The Mean Absolute Error.\n",
        "\n",
        "    Raises:\n",
        "    ValueError: If inputs are not NumPy arrays or have mismatched shapes.\n",
        "    \"\"\"\n",
        "    # Input validation\n",
        "    if not isinstance(y_pred, np.ndarray) or not isinstance(y_true, np.ndarray):\n",
        "        raise ValueError(\"Inputs must be NumPy arrays.\")\n",
        "\n",
        "    if y_pred.shape != y_true.shape:\n",
        "        raise ValueError(\"Input arrays must have the same shape.\")\n",
        "\n",
        "    if y_true.size == 0:\n",
        "        raise ValueError(\"Input arrays must not be empty.\")\n",
        "\n",
        "    # Compute the Mean Absolute Error\n",
        "    loss = np.mean(np.abs(y_pred - y_true))\n",
        "\n",
        "    return loss"
      ]
    },
